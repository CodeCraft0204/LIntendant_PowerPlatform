            "operationMetadataId": "f2ee78d5-49bc-41dd-be48-cf3f73fab822"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "sdh_activitycodeses",
              "$select": "sdh_activitycodesid,sdh_key,sdh_activitycodekey",
              "$top": 5000
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "APPLY_Activity_Code_Master": {
          "actions": {
            "CMP_Activity_Code_Key": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "4afd662c-f103-49ae-a3c7-8caab0d42338"
              },
              "type": "Compose",
              "inputs": "@if(empty(items('APPLY_Activity_Code_Master')?['Activity Code Key']),replace(items('APPLY_Activity_Code_Master')?['Activity Code'],' ',''),string(items('APPLY_Activity_Code_Master')?['Activity Code Key']))"
            },
            "CMP_Activity_SDH_Key": {
              "runAfter": {
                "CMP_Activity_Code_Key": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "08a9562d-2a8a-4e16-8047-a44edc0667b1"
              },
              "type": "Compose",
              "inputs": "@if(empty(items('APPLY_Activity_Code_Master')?['SDH Key']),concat('ACT_',outputs('CMP_Activity_Code_Key')),items('APPLY_Activity_Code_Master')?['SDH Key'])"
            },
            "FLT_Existing_Activity_Code": {
              "runAfter": {
                "CMP_Activity_SDH_Key": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "a188244f-dd07-4a81-bb00-8d4981df3afd"
              },
              "type": "Query",
              "inputs": {
                "from": "@body('LST_Existing_Activity_Codes')?['value']",
                "where": "@equals(item()?['sdh_key'], outputs('CMP_Activity_SDH_Key'))"
              }
            },
            "COND_Activity_Code_Exists": {
              "actions": {
                "UPD_Activity_Code_Master_Row": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "6aa7e0a5-be84-4ade-8c6a-59a5d07a9b51"
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "sdh_activitycodeses",
                      "recordId": "@first(body('FLT_Existing_Activity_Code'))?['sdh_activitycodesid']",
                      "item/sdh_activitycodename": "@if(empty(items('APPLY_Activity_Code_Master')?['Activity Code Name']),concat(items('APPLY_Activity_Code_Master')?['Activity Code'],' - ',items('APPLY_Activity_Code_Master')?['Description']),items('APPLY_Activity_Code_Master')?['Activity Code Name'])",
                      "item/sdh_key": "@outputs('CMP_Activity_SDH_Key')",
                      "item/sdh_activitycode": "@items('APPLY_Activity_Code_Master')?['Activity Code']",
                      "item/sdh_activitycodekey": "@outputs('CMP_Activity_Code_Key')",
                      "item/sdh_description": "@items('APPLY_Activity_Code_Master')?['Description']",
                      "item/sdh_unit": "@items('APPLY_Activity_Code_Master')?['Unit']",
                      "item/sdh_division": "@items('APPLY_Activity_Code_Master')?['Division']",
                      "item/sdh_category": "@items('APPLY_Activity_Code_Master')?['Category']",
                      "item/sdh_isactive": "@not(or(equals(toLower(string(items('APPLY_Activity_Code_Master')?['Is Active'])),'no'),equals(toLower(string(items('APPLY_Activity_Code_Master')?['Is Active'])),'false'),equals(string(items('APPLY_Activity_Code_Master')?['Is Active']),'0')))",
                      "item/sdh_sourcesystem": "@coalesce(items('APPLY_Activity_Code_Master')?['Source System'],'Activity Code Master Workbook')"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              },
              "runAfter": {
                "FLT_Existing_Activity_Code": [
                  "Succeeded"
                ]
              },
              "expression": {
                "greater": [
                  "@length(body('FLT_Existing_Activity_Code'))",
                  0
                ]
              },
              "metadata": {
                "operationMetadataId": "d60f50e4-9773-4a0c-b0c7-03ba3593bb78"
              },
              "type": "If",
              "else": {
                "actions": {
                  "ADD_Activity_Code_Master_Row": {
                    "runAfter": {},
                    "metadata": {
                      "operationMetadataId": "711a5bd4-40dc-41b0-86a6-9b06683043d6"
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "shared_commondataserviceforapps",
                        "operationId": "CreateRecord",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                      },
                      "parameters": {
                        "entityName": "sdh_activitycodeses",
                        "item/sdh_activitycodename": "@if(empty(items('APPLY_Activity_Code_Master')?['Activity Code Name']),concat(items('APPLY_Activity_Code_Master')?['Activity Code'],' - ',items('APPLY_Activity_Code_Master')?['Description']),items('APPLY_Activity_Code_Master')?['Activity Code Name'])",
                        "item/sdh_key": "@outputs('CMP_Activity_SDH_Key')",
                        "item/sdh_activitycode": "@items('APPLY_Activity_Code_Master')?['Activity Code']",
                        "item/sdh_activitycodekey": "@outputs('CMP_Activity_Code_Key')",
                        "item/sdh_description": "@items('APPLY_Activity_Code_Master')?['Description']",
                        "item/sdh_unit": "@items('APPLY_Activity_Code_Master')?['Unit']",
                        "item/sdh_division": "@items('APPLY_Activity_Code_Master')?['Division']",
                        "item/sdh_category": "@items('APPLY_Activity_Code_Master')?['Category']",
                        "item/sdh_isactive": "@not(or(equals(toLower(string(items('APPLY_Activity_Code_Master')?['Is Active'])),'no'),equals(toLower(string(items('APPLY_Activity_Code_Master')?['Is Active'])),'false'),equals(string(items('APPLY_Activity_Code_Master')?['Is Active']),'0')))",
                        "item/sdh_sourcesystem": "@coalesce(items('APPLY_Activity_Code_Master')?['Source System'],'Activity Code Master Workbook')"
                      },
                      "authentication": "@parameters('$authentication')"
                    }
                  }
                }
              }
            }
          },
          "foreach": "@body('LST_Activity_Code_Master_Rows')?['value']",
          "runAfter": {
            "LST_Existing_Activity_Codes": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "627068e6-2976-43bf-ba79-ed355b8c2dfb"
          },
          "type": "Foreach",
          "runtimeConfiguration": {
            "concurrency": {
              "repetitions": 10
            }
          }
        }
      }
    },
    "templateName": ""
  },
