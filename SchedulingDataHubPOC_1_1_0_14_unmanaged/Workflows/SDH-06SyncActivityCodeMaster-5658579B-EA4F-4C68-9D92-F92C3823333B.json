      "actions": {
        "GET_Activity_Code_Master_File": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "f69d2595-009d-415c-ad92-0c91235ecada"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_sharepointonline",
              "operationId": "GetFileMetadataByPath",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline"
            },
            "parameters": {
              "dataset": "https://lintendant1.sharepoint.com/sites/232408-UtileArdoise2.0",
              "path": "/Documents partages/POC-SchedulingDataHub/Master/ActivityCodeMaster.xlsx"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "LST_Activity_Code_Master_Rows": {
          "runAfter": {
