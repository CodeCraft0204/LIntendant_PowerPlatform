        "CATCH_Finalize_Import": {
          "actions": {
            "CMP_Finalize_Error": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "80e8a7ec-a309-45f5-bade-2ecf7372424d"
              },
              "type": "Compose",
              "inputs": "@substring(concat('Finalize/notify warning: ', string(result('TRY_Finalize_Import'))),0,min(1900,length(concat('Finalize/notify warning: ', string(result('TRY_Finalize_Import'))))))"
            },
            "UPD_Import_Run_Finalize_Warning": {
              "runAfter": {
                "CMP_Finalize_Error": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "8f430a7c-e579-4b4e-a657-736b80f341d7"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sdh_importruns",
                  "recordId": "@replace(replace(triggerBody()?['importRunId'], '{', ''), '}', '')",
                  "item/sdh_importstatus": 232400004,
                  "item/sdh_completedat": "@utcNow()",
                  "item/sdh_warningcount": "@add(int(triggerBody()?['warningCount']),1)",
                  "item/sdh_errormessage": "@outputs('CMP_Finalize_Error')"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "SND_Finalize_Warning_Email": {
              "runAfter": {
                "UPD_Import_Run_Finalize_Warning": [
                  "Succeeded",
                  "Failed"
                ]
              },
              "metadata": {
                "operationMetadataId": "cebfb131-e298-4c64-9c3c-879e62e7fda7"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                },
                "parameters": {
                  "emailMessage/To": "@triggerBody()?['notificationEmail']",
                  "emailMessage/Subject": "@concat('SDH import completed with post-processing warning - ', triggerBody()?['projectNumber'])",
                  "emailMessage/Body": "@concat('<p>The data import completed, but finalization, archival, or notification had a warning.</p><pre>', outputs('CMP_Finalize_Error'), '</pre>')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "RESP_Finalize_Warning": {
              "runAfter": {
                "SND_Finalize_Warning_Email": [
