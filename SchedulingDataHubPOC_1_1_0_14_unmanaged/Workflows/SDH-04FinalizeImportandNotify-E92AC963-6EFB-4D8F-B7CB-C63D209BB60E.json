                  "item/sdh_constructionstartdate": "@first(body('LST_Current_Snapshot')?['value'])?['sdh_constructionstartdate']",
                  "item/sdh_constructionfinishdate": "@first(body('LST_Current_Snapshot')?['value'])?['sdh_constructionfinishdate']",
                  "item/sdh_latestconstructionprogresspercent": "@first(body('LST_Current_Snapshot')?['value'])?['sdh_constructionprogresspercent']",
                  "item/sdh_substantialcompletiondate": "@first(body('LST_Current_Snapshot')?['value'])?['sdh_substantialcompletiondate']"
