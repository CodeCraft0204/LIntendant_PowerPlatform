                  "operationId": "UpdateOnlyRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "sdh_importruns",
                  "recordId": "@outputs('CMP_Import_Run_ID')",
                  "item/sdh_importstatus": "@if(greater(int(triggerBody()?['warningCount']),0),232400004,232400003)",
                  "item/sdh_completedat": "@utcNow()",
                  "item/sdh_rowsimported": "@int(triggerBody()?['rowsImported'])",
                  "item/sdh_warningcount": "@int(triggerBody()?['warningCount'])",
                  "item/sdh_errorcount": 0
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "SND_Completion_Email": {
              "runAfter": {
                "UPD_Import_Run_Completed": [
