                "parameters": {
                  "emailMessage/To": "@triggerBody()?['notificationEmail']",
                  "emailMessage/Subject": "@concat('SDH import completed - ', outputs('CMP_Project_Number'))",
                  "emailMessage/Body": "@concat('<p>The schedule import completed for project <strong>', outputs('CMP_Project_Number'), '</strong>.</p><p>Snapshot: ', first(body('LST_Current_Snapshot')?['value'])?['sdh_snapshotname'], '<br/>Rows imported: ', triggerBody()?['rowsImported'], '<br/>Warnings: ', triggerBody()?['warningCount'], '</p>')",
                  "emailMessage/Importance": "Normal"
                },
                "authentication": "@parameters('$authentication')"
              }
